---
import { Picture } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import {
  regionLandings,
  regionLandingSlugs,
  BRAND_AREA,
  type RegionImageKey,
} from "../../data/regionLandings";
import { MapPin, ArrowRight, Phone } from "@lucide/astro";

import schleswigImg from "../../images/regions/schleswig.png";
import flensburgImg from "../../images/regions/flensburg.png";
import kielImg from "../../images/regions/kiel.png";

const imageByKey: Record<RegionImageKey, typeof schleswigImg> = {
  schleswig: schleswigImg,
  flensburg: flensburgImg,
  kiel: kielImg,
};

const regions = regionLandingSlugs.map((slug) => regionLandings[slug]);

const BRAND = {
  name: "EMSIG Gebäudedienste GmbH",
  phone: "+49 4621 930245",
};

const title = `Regionen & Einsatzgebiete in ${BRAND_AREA} | EMSIG`;
const description = `Unsere Reinigungsregionen in ${BRAND_AREA}: Schleswig, Flensburg und Kiel. Büro-, Glas-, Fassaden-, Bau- und PV-Reinigung – versichert und zuverlässig vor Ort.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Reinigungsregionen in ${BRAND_AREA}`,
  itemListElement: regions.map((region, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: region.name,
    url: new URL(`/regionen/${region.slug}`, "https://emsig.sh/").href,
  })),
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="relative w-full py-12 md:py-16 bg-gradient-to-br from-blue-50 to-white border-b border-gray-100">
    <div class="max-w-[1280px] mx-auto px-4 md:px-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wide mb-4">
          <MapPin class="h-4 w-4" />
          Einsatzgebiete
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-main-light mb-4">
          Unsere Regionen in {BRAND_AREA}
        </h1>
        <p class="text-lg text-text-sub-light leading-relaxed">
          Von Schleswig aus betreuen wir Privathaushalte, Büros und Gewerbe in {BRAND_AREA}. Wählen Sie Ihre Region für lokale Leistungen, Stadtteile und Ansprechpartner:innen vor Ort.
        </p>
      </div>
    </div>
  </section>

  <main class="py-12 md:py-20">
    <div class="max-w-[1280px] mx-auto px-4 md:px-10">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          regions.map((region) => (
            <a
              href={`/regionen/${region.slug}`}
              class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
            >
              <div class="aspect-[4/3] w-full overflow-hidden bg-gray-200">
                <Picture
                  src={imageByKey[region.imageKey]}
                  alt={region.imageAlt}
                  formats={["avif", "webp"]}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6 flex flex-col flex-1">
                <h2 class="text-xl font-bold text-text-main-light mb-2 flex items-center gap-2">
                  <MapPin class="h-5 w-5 text-primary" />
                  {region.name}
                </h2>
                <p class="text-text-sub-light text-sm leading-relaxed mb-5 flex-1">{region.lead}</p>
                <span class="inline-flex items-center gap-1 text-primary font-bold text-sm group-hover:gap-2 transition-all">
                  Region ansehen
                  <ArrowRight class="h-4 w-4" />
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-14 rounded-2xl bg-primary text-white p-8 md:p-12 relative overflow-hidden">
        <div
          class="absolute inset-0 opacity-10"
          style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"
        >
        </div>
        <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="max-w-2xl">
            <h2 class="text-2xl md:text-3xl font-bold mb-2">Ihr Ort ist nicht dabei?</h2>
            <p class="text-blue-100">
              Wir sind in ganz {BRAND_AREA} unterwegs. Nennen Sie uns Ort und Objekt – wir prüfen Verfügbarkeit und melden uns mit einem Angebot.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-white px-6 py-3 text-primary font-bold hover:bg-gray-100 transition-colors"
            >
              Angebot anfragen
              <ArrowRight class="h-5 w-5" />
            </a>
            <a
              href={`tel:${BRAND.phone.replace(/\s/g, "")}`}
              class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white px-6 py-3 font-bold text-white hover:bg-white/10 transition-colors"
            >
              <Phone class="h-5 w-5" />
              {BRAND.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
